---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { articles } from '~/lib/articles';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { marked } from 'marked';

export async function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug } }));
}

const { params } = Astro;
const article = articles.find((item) => item.slug === params.slug);
if (!article) {
  throw new Error('Article not found');
}
const pageTitle = `${article.title} · LabDecoded`;
---
<BaseLayout title={pageTitle} description={article.description} pathname={`/articles/${article.slug}`}>
  <Header />
  <section class="container section">
    <Breadcrumbs items={[{ href: '/', label: 'Home' }, { href: '/articles', label: 'Articles' }, { label: article.title }]} />
    <div class="page-heading" style="margin-top:1rem;">
      <p class="badge">{article.category}</p>
      <h1>{article.title}</h1>
      <p>{article.description}</p>
      <p class="small-text">By {article.author} • Published {article.date} • Updated {article.updated}</p>
    </div>
    <div class="card metric-card prose" style="margin-top:1.5rem;">
      <div innerHTML={marked(article.body)} />
    </div>
    <div class="card metric-card" style="margin-top:1.5rem;">
      <h3>Related LabDecoded Calculators</h3>
      <p>Search the calculator library to explore tools associated with this topic.</p>
    </div>
  </section>
  <Footer />
</BaseLayout>
