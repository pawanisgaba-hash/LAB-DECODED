---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { calculators } from '~/data/calculators';
import { articles } from '~/lib/articles';
---
<BaseLayout title="Search · LabDecoded" description="Search clinical calculators, articles and laboratory topics on LabDecoded." pathname="/search">
  <Header />
  <section class="container section">
    <div class="page-heading">
      <p class="badge">Search</p>
      <h1>Search calculators and laboratory resources</h1>
      <p>Find clinical tools, procedures, and articles by keyword.</p>
    </div>
    <div class="card search-card" style="margin-top:1.5rem;">
      <div class="search-field">
        <label class="input-label" for="site-search">Search calculators, tests and laboratory topics</label>
        <input id="site-search" class="input-control" placeholder="e.g. creatinine, FIB-4, testosterone" />
      </div>
    </div>
    <div id="searchResults" class="grid grid-3" style="margin-top:1.5rem;"></div>
  </section>
  <Footer />
  <script id="searchData" type="application/json" set:html={JSON.stringify({ calculators: calculators.map((calc) => ({ title: calc.name, description: calc.shortDescription, url: `/calculators/${calc.slug}`, type: 'Calculator', keywords: calc.keywords, category: calc.category })), articles: articles.map((article) => ({ title: article.title, description: article.description, url: `/articles/${article.slug}`, type: 'Article', keywords: article.tags, category: article.category })) })}></script>
  <script type="module">
    const { calculators, articles } = JSON.parse(document.getElementById('searchData').textContent);
    const searchInput = document.getElementById('site-search');
    const resultsEl = document.getElementById('searchResults');
    const items = [...calculators, ...articles];
    function renderResults(query) {
      resultsEl.innerHTML = '';
      if (!query) {
        resultsEl.innerHTML = '<p style="grid-column:1/-1; color: var(--muted);">Enter a search term to browse calculators and articles.</p>';
        return;
      }
      const normalized = query.toLowerCase();
      const matches = items.filter((item) => item.title.toLowerCase().includes(normalized) || item.description.toLowerCase().includes(normalized) || item.keywords.some((keyword) => keyword.toLowerCase().includes(normalized)) || item.category.toLowerCase().includes(normalized));
      if (!matches.length) {
        resultsEl.innerHTML = '<p style="grid-column:1/-1; color: var(--muted);">No matching calculators or articles found.</p>';
        return;
      }
      resultsEl.innerHTML = matches.slice(0, 24).map((item) => `
        <article class="card metric-card">
          <div>
            <p class="badge">${item.type}</p>
            <h3>${item.title}</h3>
            <p>${item.description}</p>
          </div>
          <a class="button button-secondary" href="${item.url}">Open</a>
        </article>
      `).join('');
    }
    searchInput.addEventListener('input', () => renderResults(searchInput.value));
    renderResults('');
  </script>
</BaseLayout>
