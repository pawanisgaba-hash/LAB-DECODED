---
const { title, description, pathname, image } = Astro.props;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={pathname ? `https://labdecoded.org${pathname}` : 'https://labdecoded.org'} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pathname ? `https://labdecoded.org${pathname}` : 'https://labdecoded.org'} />
<meta property="og:image" content={image ?? 'https://labdecoded.org/og-image.png'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image ?? 'https://labdecoded.org/og-image.png'} />
